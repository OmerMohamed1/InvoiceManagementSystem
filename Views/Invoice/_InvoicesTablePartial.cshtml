@using InvoiceManagementSystem.Models
@model IEnumerable<Invoice>

@{
    int pageIndex = ViewBag.PageIndex ?? 1;  // تأكد من أن لديك pageIndex في الـ ViewBag
    int pageSize = ViewBag.PageSize ?? 5;    // تأكد من أن لديك pageSize في الـ ViewBag
    int count = (pageIndex - 1) * pageSize + 1; ;
}

<div class="table-responsive">
    <table class="table table-bordered table-striped ">
        <thead class="thead-custom">
            <tr>
                <th class="text-center">Id</th>
                <th class="text-center">Invoice Date</th>
                <th class="text-center">Total Amount</th>
                <th class="text-center">Edit</th>
                <th class="text-center">View</th>
                <th class="text-center">Print Small</th>
                <th class="text-center">Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@count</td>
                    <td> @item.InvoiceDate.ToString("dd-MM-yyyy")</td>
                    <td>@Html.DisplayFor(modelItem => item.TotalAmount)</td>
                    <td class="text-center">

                        <a href="javascript:void(0);" class="btn btn-warning btn-sm mx-2 mb-2 editInvoiceBtn" data-id="@item.InvoiceId">
                            <i class="fas fa-edit"></i>
                        </a>
                    </td>
                    <td class="text-center">
                        <a href="javascript:void(0);" class="btn btn-info btn-sm mx-2 mb-2 detailsInvoiceBtn" data-id="@item.InvoiceId">
                            <i class="fas fa-eye"></i>
                        </a>
                    </td>
                    <td class="text-center">
                        <a href="javascript:void(0);" id="printInvoicSmalleBtn" class="btn btn-primary btn-sm mx-2 mb-2" data-id="@item.InvoiceId"> <i class="fas fa-print"></i> </a>
                    </td>
                    <td class="text-center">
                        <form asp-action="Delete" method="post" class="d-inline deleteForm">
                            <input type="hidden" name="id" value="@item.InvoiceId" />
                            <button type="submit" class="btn btn-danger btn-sm mx-2 mb-2">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>
                    </td>
                </tr>
                count++;
            }
        </tbody>
    </table>
    <nav aria-label="Page navigation example">
        <ul class="pagination">
            <li class="page-item">
                <a class="page-link" href="#" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
            <li class="page-item"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item">
                <a class="page-link" href="#" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>



</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="/js/DeleteItem.js"></script>
}