    <p style="text-align: center; font-size: 1.2em; margin-top: 20px;">THANK YOU!</p>

    <div class="invoice-footer text-center">
        <hr />
        <a asp-action="Index" class="btn btn-secondary mx-2 mb-2">Back to List</a>

