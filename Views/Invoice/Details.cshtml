        <a href="@Url.Action("PrintInvoiceSmall", "Invoice", new { invoiceId = Model.InvoiceId })" class="btn btn-info mx-2 mb-2">Print Invoice MINI</a>

        <button onclick="window.print()" class="btn btn-success mx-2 mb-2">Print Invoice A4</button>
    </div>
