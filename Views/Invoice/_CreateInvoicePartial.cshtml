@using InvoiceManagementSystem.ViewMoldel
@model InvoiceViewModel

<form  asp-action="Create" asp-controller="Invoice"  id="createInvoiceForm" method="post">

    <div class="form-container border rounded p-4 bg-light">
        <div class="row mb-3">
            <div class="col-12">
                <div class="form-group">
                    <label for="invoiceDate" class="form-label">Invoice Date</label>
                    @Html.TextBoxFor(model => model.InvoiceDate, new { @class = "form-control", id = "invoiceDate" })
                </div>
            </div>
        </div>

        <div class="form-group mb-4">
            <label class="form-label">Invoice Items</label>
            <div class="table-container border rounded bg-white p-3">
                <div class="table-responsive">
                    <table id="invoice-items-table" class="table table-bordered table-responsive">
                        <thead class="table-primary">
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Total Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.InvoiceItems.Count; i++)
                            {
                                <tr>
                                    <td>@Html.DropDownListFor(m => m.InvoiceItems[i].ProductId, Model.Products, new { @class = "form-control" })</td>
                                    <td>@Html.TextBoxFor(m => m.InvoiceItems[i].Quantity, new { @class = "form-control", placeholder = "Quantity", type = "number" })</td>
                                    <td>@Html.TextBoxFor(m => m.InvoiceItems[i].UnitPrice, new { @class = "form-control", placeholder = "Unit Price", type = "number", step = "0.01" })</td>
                                    <td>@Html.DisplayFor(m => m.InvoiceItems[i].TotalPrice)</td>
                                    <td><button type="button" onclick="removeRow(this)" class="btn btn-danger">Remove</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                    <button type="button" onclick="addRow()" class="btn btn-primary">Add Item</button>
                </div>
            </div>

        <div class="form-group mb-4">
            <label id="total-amount" for="totalAmount" class="form-label">Total Amount: </label>
            @Html.DisplayFor(model => model.TotalAmount, new { @class = "form-control-plaintext" })
        </div>
    </div>
</form>
