@using InvoiceManagementSystem.Models
@model Product

@{
    ViewData["Title"] = "Product Details";
}

<div id="detailsContent">
   
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3 font-weight-bold">
                        Product Id
                    </dt>
                    <dd class="col-sm-9">
                        @Html.DisplayFor(model => model.ProductId)
                    </dd>
                    <dt class="col-sm-3 font-weight-bold">
