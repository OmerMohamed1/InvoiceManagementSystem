@using InvoiceManagementSystem.Models
@model IEnumerable<Product>
@{
    int count = 1;
}
<div class="table-responsive">
    <table class="table table-bordered table-striped ">
        <thead class="thead-custom">
            <tr>
                <th class="text-center">Id</th>
                <th class="text-center">Product Name</th>
                <th class="text-center">Unit Price</th>
                <th class="text-center">Edit</th>
                <th class="text-center">View</th>
                <th class="text-center">Delete</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                
                <tr>
                    <td>
                        @count
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ProductName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.UnitPrice)
                    </td>
                    <td class="text-center">
                        <a href="javascript:void(0);" class="btn btn-warning btn-sm mx-2 mb-2 editProductBtn" data-id="@item.ProductId">
                            <i class="fas fa-edit"></i>
                        </a>
                    </td>
                    <td class="text-center">
                        <a href="javascript:void(0);" class="btn btn-info btn-sm mx-2 mb-2 detailsProductBtn" data-id="@item.ProductId">
                            <i class="fas fa-eye"></i>
                        </a>
                    </td>

                    <td class="text-center">
                        <form asp-action="Delete" method="post" class="d-inline deleteForm">
                            <input type="hidden" name="id" value="@item.ProductId" />
                            <button type="submit" class="btn btn-danger btn-sm mx-2 mb-2">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </form>

                    </td>
                </tr>
                count++;
            }
        </tbody>
    </table>
</div>