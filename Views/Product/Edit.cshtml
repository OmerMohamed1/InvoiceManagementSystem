@using InvoiceManagementSystem.Models
@model Product

@{
    ViewData["Title"] = "Edit Product";
}



<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient text-white">
            <h4 class="mb-0 text-primary">Edit Product</h4>
        </div>
        <div class="card-body">

            <form asp-action="Edit" asp-controller="Product" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="ProductId" />

                <div class="form-group mb-3">
                    <label asp-for="ProductName" class="form-label">Product Name</label>
                    <input asp-for="ProductName" class="form-control" />
                    <span asp-validation-for="ProductName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="UnitPrice" class="form-label">Unit Price</label>
                    <input asp-for="UnitPrice" class="form-control" />
                    <span asp-validation-for="UnitPrice" class="text-danger"></span>
                </div>

                <div class="text-end mt-4">
                    <input type="submit" value="Save" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

