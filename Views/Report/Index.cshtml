@using InvoiceManagementSystem.ViewMoldel
@model IEnumerable<ReportViewMoldel>

@{
    ViewData["Title"] = "Index";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient text-white d-flex justify-content-between flex-wrap">
            @*<div class="mb-2 d-flex flex-wrap">
            <a id="exportPdfBtn" href="#" class="btn btn-primary mb-2"> <i class="fas fa-file-pdf"></i> Export to PDF</a>
            <a id="exportExcelBtn" href="#" class="btn btn-primary mb-2"> <i class="fas fa-file-excel"></i> Export to Excel</a>
        </div>*@


            @*<div class="ml-auto mb-2 d-flex flex-wrap">
            <button id="dailyReportBtn" class="btn @((ViewBag.ActiveReport == "daily") ? "btn-info active" : "btn-info") mb-2">Daily Report</button>
            <button id="weeklyReportBtn" class="btn @((ViewBag.ActiveReport == "weekly") ? "btn-info active" : "btn-info") mb-2">Weekly Report</button>
            <button id="monthlyReportBtn" class="btn @((ViewBag.ActiveReport == "monthly") ? "btn-info active" : "btn-info") mb-2">Monthly Report</button>
        </div>*@

            <div class="mb-2 d-flex justify-content-start align-items-center gap-2">
                <a id="exportPdfBtn" href="#" class="btn btn-primary">
                    <i class="fas fa-file-pdf"></i> Export to PDF
                </a>
                <a id="exportExcelBtn" href="#" class="btn btn-primary">
                    <i class="fas fa-file-excel"></i> Export to Excel
                </a>
            </div>

            <div class="mb-2 d-flex justify-content-start align-items-center gap-2">
                <button id="generateReportBtn" class="btn btn-info">View Report</button>
                <input id="endDate" type="date" class="form-control form-control-sm" style="width: 150px;" />
                <input id="startDate" type="date" class="form-control form-control-sm" style="width: 150px;" />
            </div>


        </div>

        <div class="card-body">
            <div id="ReportTableContainer">
                @await Html.PartialAsync("_ReportTablePartial", Model)
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
       // var reportType = 'daily'; // القيمة الافتراضية

        //// تحديث الروابط عند الضغط على الأزرار
        //function updateExportLinks() {
        //    $('#exportPdfBtn').attr('href', '/Report/ExportToPDF?reportType=');
        //    $('#exportExcelBtn').attr('href', '/Report/ExportToExcel?reportType=');
        //}



        // Get Report
        //=================================================================================//

        function updateExportLinks(startDate, endDate) {
            const exportPdfBtn = document.getElementById("exportPdfBtn");
            const exportExcelBtn = document.getElementById("exportExcelBtn");

            exportPdfBtn.href = `/Report/ExportToPDF?startDate=${startDate}&endDate=${endDate}`;
            exportExcelBtn.href = `/Report/ExportToExcel?startDate=${startDate}&endDate=${endDate}`;
        }

        document.addEventListener("DOMContentLoaded", function () {
            const startDateInput = document.getElementById("startDate");
            const endDateInput = document.getElementById("endDate");
            const exportPdfBtn = document.getElementById("exportPdfBtn");
            const exportExcelBtn = document.getElementById("exportExcelBtn");

            // تعيين القيم الافتراضية
            const today = new Date().toISOString().split("T")[0];
            startDateInput.value = today;
            endDateInput.value = today;

            // تحديث روابط الطباعة بالقيم الافتراضية
            updateExportLinks(today, today);
        });

        document.getElementById("generateReportBtn").addEventListener("click", function () {
            const startDate = document.getElementById("startDate").value;
            const endDate = document.getElementById("endDate").value;

            console.log("Start Date Selected:", startDate);
            console.log("End Date Selected:", endDate);

            if (!startDate || !endDate) {
                alert("Please select both start and end dates.");
                return;
            }

            const exportPdfBtn = document.getElementById("exportPdfBtn");
            const exportExcelBtn = document.getElementById("exportExcelBtn");

            exportPdfBtn.href = `/Report/ExportToPDF?startDate=${startDate}&endDate=${endDate}`;
            exportExcelBtn.href = `/Report/ExportToExcel?startDate=${startDate}&endDate=${endDate}`;

            fetch(`/Report/GetInvoicesReport?startDate=${startDate}&endDate=${endDate}`, {
                method: "GET",
                headers: {
                    "Content-Type": "application/json"
                }
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Failed to fetch the report.");
                    }
                    return response.text();
                })
                .then(html => {
                    document.getElementById("ReportTableContainer").innerHTML = html;
                })
                .catch(error => {
                    console.error("Error:", error);
                    alert("An error occurred while generating the report.");
                });
        });



                                // Daily Report
        //=================================================================================//
        $(document).on('click', '#dailyReportBtn', function () {
            reportType = 'daily';
            updateExportLinks();
            $.ajax({
                url: '/Report/DailyInvoicesReport',
                type: 'GET',
                success: function (data) {
                    $('#ReportTableContainer').html(data);
                },
                error: function (xhr, status, error) {
                    alert('Error updating table: ' + error);
                }
            });
        });


                              // Weekly Report
        //=================================================================================//
        $(document).on('click', '#weeklyReportBtn', function () {
            reportType = 'weekly';
            updateExportLinks();
            $.ajax({
                url: '/Report/WeeklyInvoicesReport',
                type: 'GET',
                success: function (data) {
                    $('#ReportTableContainer').html(data);
                },
                error: function (xhr, status, error) {
                    alert('Error updating table: ' + error);
                }
            });
        });


                            // Monthly Report
        //=================================================================================//
        $(document).on('click', '#monthlyReportBtn', function () {
            reportType = 'monthly';
            updateExportLinks();
            $.ajax({
                url: '/Report/MonthlyInvoicesReport',
                type: 'GET',
                success: function (data) {
                    $('#ReportTableContainer').html(data);
                },
                error: function (xhr, status, error) {
                    alert('Error updating table: ' + error);
                }
            });
        });

        // تحديث الروابط عند تحميل الصفحة
        updateExportLinks();
    </script>
}


<!-- Custom CSS for enhanced styling -->
<style>
    .btn {
        margin-right: 5px; /* تباعد بين الأزرار */
        margin-bottom: 5px; /* تباعد عمودي بين الأزرار */
    }
    /* إذا كنت تريد أن تكون الأزرار في نفس السطر وتبتعد عن بعضها البعض */
    .d-flex .btn {
        margin-right: 10px;
    }
</style>
